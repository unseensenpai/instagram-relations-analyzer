{
  "manifest_version": 3,
  "name": "IG Relations - Follower Analyzer",
  "version": "1.3.1",
  "description": "Compare Instagram followers and following lists to analyze your profile relations.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "https://*.instagram.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.instagram.com/*"],
      "js": ["src/content.js"],
      "run_at": "document_end"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/ui/modal.html",
        "src/ui/modal.css",
        "src/ui/modal.js",
        "src/ui/i18n.js",
        "src/ui/compare.js",
        "src/ui/history.js",
        "src/ui/profile-url.js",
        "src/ui/html-export.js"
      ],
      "matches": ["https://*.instagram.com/*"]
    }
  ]
}